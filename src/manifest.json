{
  "manifest_version": 3,
  "name": "Fat Cat",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "A quiet, chubby companion. Try a draggable cat on your current page.",
  "action": {
    "default_title": "Meet Fat Cat",
    "default_popup": "popup/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  }
}
